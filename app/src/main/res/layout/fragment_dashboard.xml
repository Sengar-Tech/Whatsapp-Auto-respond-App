<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Permission warning banner — hidden until needed -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/permission_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFEB3B"
            app:cardCornerRadius="8dp">
            <TextView
                android:id="@+id/permission_warning_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/permission_warning"
                android:textColor="#333333"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Service health warning — hidden until needed -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/service_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/status_orange"
            app:cardCornerRadius="8dp">
            <TextView
                android:id="@+id/service_warning_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/service_warning"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Service control card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Status row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/status_red"
                        android:layout_marginEnd="10dp"/>

                    <!-- round corners on the dot via background shape would require a drawable,
                         but a simple colored square is fine for now -->

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/service_stopped"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/service_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Toggle to start/stop monitoring WhatsApp notifications."
                    android:textColor="#666666"
                    android:textSize="13sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Replies"
                    android:textColor="#666666"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/replies_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 replies sent today"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
